mode: rule
mixed-port: 7897
allow-lan: false
log-level: info
ipv6: true
secret: set-your-secret
unified-delay: true
dns:
  enable: true
  ipv6: true
  use-hosts: true
  cache-algorithm: arc
  use-system-hosts: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/15
  fake-ip-range6: 2001:2::1/48
  fake-ip-filter:
  - rule-set:private
  - rule-set:fakeip_filter
  - rule-set:geolocation-cn
  default-nameserver:
  - 114.114.114.114#DIRECT
  - tls://223.5.5.5#DIRECT
  - https://1.12.12.12/dns-query#DIRECT
  proxy-server-nameserver:
  - 114.114.114.114#DIRECT
  - tls://223.5.5.5#DIRECT
  - https://doh.pub/dns-query#DIRECT
  nameserver:
  - https://cloudflare-dns.com/dns-query#默认代理
  - https://dns.google/dns-query#默认代理
  nameserver-policy:
    rule-set:cn:
    - 223.5.5.5#DIRECT
    - 119.29.29.29#DIRECT
  direct-nameserver:
  - 223.5.5.5#DIRECT
  - 119.29.29.29#DIRECT
hosts:
  doh.pub:
  - 1.12.12.12
  - 120.53.53.53
  cloudflare-dns.com:
  - 1.1.1.1
  - 1.0.0.1
  dns.google:
  - 8.8.8.8
  - 8.8.4.4
  services.googleapis.cn: services.googleapis.com
  +.mcdn.bilivideo.com:
  - 0.0.0.0
  +.mcdn.bilivideo.cn:
  - 0.0.0.0
  +.edge.mountaintoys.cn:
  - 0.0.0.0
  +.h2.smtcdns.net:
  - 0.0.0.0
external-controller-cors:
  allow-private-network: true
  allow-origins:
  - tauri://localhost
  - http://tauri.localhost
  - https://yacd.metacubex.one
  - https://metacubex.github.io
  - https://board.zash.run.place
external-controller-pipe: \\.\pipe\verge-mihomo
bind-address: '*'
tun:
  enable: true
  stack: mixed
  auto-route: true
  strict-route: true
  auto-redirect: true
  auto-detect-interface: true
  dns-hijack:
  - any:53
  - tcp://any:53
tcp-concurrent: true
keep-alive-interval: 60
find-process-mode: strict
external-ui: ui
external-ui-url: https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip
profile:
  store-selected: true
  store-fake-ip: true
ntp:
  enable: true
  write-to-system: false
  server: ntp.aliyun.com
  port: 123
  interval: 60
proxies:
- name: 🇨🇳 直连 | 双栈
  type: direct
- name: 🇨🇳 直连 | IPv4优先
  type: direct
  ip-version: ipv4-prefer
- name: 🇨🇳 直连 | IPv6优先
  type: direct
  ip-version: ipv6-prefer
- name: 🇨🇳 直连 | 仅IPv4
  type: direct
  ip-version: ipv4
- name: 🇨🇳 直连 | 仅IPv6
  type: direct
  ip-version: ipv6
proxy-providers:
  发哥:
    type: http
    url: "https://raw.githubusercontent.com/shaoyouvip/free/refs/heads/main/mihomo.yaml"
    # interval: 86400
    override:
      additional-prefix: "发哥 | "
  酷:
    type: http
    url: "https://raw.githubusercontent.com/kooker/FreeSubsCheck/refs/heads/main/mihomo.yaml"
    # interval: 86400
    override:
      additional-prefix: "酷客 | "

proxy-groups:
- interval: 600
  timeout: 3000
  url: https://www.apple.com/library/test/success.html
  lazy: true
  max-failed-times: 3
  empty-fallback: REJECT
  type: select
  name: GLOBAL
  proxies:
  - 默认代理
  - 直连
  icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Global.png
- interval: 600
  timeout: 3000
  url: https://www.apple.com/library/test/success.html
  lazy: true
  max-failed-times: 3
  empty-fallback: REJECT
  type: select
  name: 默认代理
  use:
  - 发哥
  - 酷
  proxies:
  - 直连
  icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png
- interval: 600
  timeout: 3000
  url: https://www.apple.com/library/test/success.html
  lazy: true
  max-failed-times: 3
  empty-fallback: REJECT
  type: select
  name: 直连
  proxies:
  - 🇨🇳 直连 | 双栈
  - 🇨🇳 直连 | IPv4优先
  - 🇨🇳 直连 | IPv6优先
  - 🇨🇳 直连 | 仅IPv4
  - 🇨🇳 直连 | 仅IPv6
  icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/China.png
  hidden: true
rule-providers:
